# Replace with a published immutable release tag. Do not use `latest`.
CF_MAIL_RELAY_VERSION=vX.Y.Z

# SMTP banner identity and Worker endpoint.
RELAY_DOMAIN=smtp.example.com
RELAY_WORKER_URL=https://mail.example.com

# Copy these from the setup runbook. Keep this file mode 0600.
RELAY_KEY_ID=rel_01
RELAY_HMAC_SECRET=replace-with-the-generated-secret

# Optional limits. The defaults below match the relay defaults.
RELAY_MAX_BYTES=4718592
RELAY_CONN_PER_MIN=60
RELAY_AUTH_PER_MIN=20
RELAY_AUTH_LOCKOUT_BASE_SECONDS=30
